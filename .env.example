# Copy this file to `.env.local` and fill in your values.

# Formspree form ID that powers the contact form.
# Create a free form at https://formspree.io and paste the ID from your
# endpoint URL (https://formspree.io/f/<THIS_PART>).
# If left blank, the contact form gracefully falls back to a mailto: link.
NEXT_PUBLIC_FORMSPREE_ID=
