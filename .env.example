# Copy this file to `.env.local` and fill in your values.
#
# The contact form does NOT need configuration. It posts to Formspree
# through @formspree/react, and the form id is a constant in
# components/sections/Contact.tsx (it is public either way, since it ships
# in the client bundle).

# OPTIONAL: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Vercel Web Analytics works with no config once enabled in the Vercel
# dashboard; set this only if you ALSO want GA4's deeper demographic reports.
# Leaving it blank keeps GA4 fully disabled (no script loaded).
NEXT_PUBLIC_GA_ID=
