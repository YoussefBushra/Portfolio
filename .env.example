# Copy this file to `.env.local` for local overrides.
#
# NOTHING HERE IS REQUIRED. The site builds and runs with no environment
# variables at all, locally and on Vercel.
#
# The contact form needs no configuration: it posts to Formspree through
# @formspree/react, and the form id is a constant in
# components/sections/Contact.tsx (it is public either way, since it ships
# in the client bundle).
#
# Vercel Web Analytics and Speed Insights need no keys either. They are
# wired in app/layout.tsx and activate once you switch them on in the
# Vercel dashboard under Project > Analytics and Project > Speed Insights.

# OPTIONAL: absolute base URL, used for canonical links and the Open Graph
# image. On Vercel this is derived from the project's production URL
# automatically, so set it only once a custom domain is attached.
# NEXT_PUBLIC_SITE_URL=https://youssefbushra.com

# OPTIONAL: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Only needed if you want GA4's demographic reports on top of Vercel
# Analytics. Leaving it blank keeps GA4 fully disabled, no script loaded.
NEXT_PUBLIC_GA_ID=
